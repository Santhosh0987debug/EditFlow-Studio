generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  projects     Project[]

  @@map("users")
}

model Project {
  id           String        @id @default(cuid())
  name         String
  description  String?
  ownerId      String        @map("owner_id")
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  textDocument TextDocument?
  images       ImageAsset[]
  audio        AudioAsset[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([ownerId, updatedAt])
  @@map("projects")
}

model TextDocument {
  id        String        @id @default(cuid())
  projectId String        @unique @map("project_id")
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  versions  TextVersion[]

  @@map("text_documents")
}

enum TextVersionSource {
  manual
  ai_accepted
  restored
}

model TextVersion {
  id         String            @id @default(cuid())
  documentId String            @map("document_id")
  document   TextDocument      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    Int
  title      String
  content    String            @db.Text
  source     TextVersionSource @default(manual)
  createdAt  DateTime          @default(now()) @map("created_at")

  @@unique([documentId, version])
  @@index([documentId, createdAt])
  @@map("text_versions")
}

model ImageAsset {
  id               String         @id @default(cuid())
  projectId        String         @map("project_id")
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  originalFilename String         @map("original_filename")
  mimeType         String         @map("mime_type")
  width            Int
  height           Int
  byteSize         Int            @map("byte_size")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  versions         ImageVersion[]

  @@index([projectId, updatedAt])
  @@map("image_assets")
}

enum ImageVersionSource {
  original
  edited
}

model ImageVersion {
  id         String             @id @default(cuid())
  assetId    String             @map("asset_id")
  asset      ImageAsset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  version    Int
  source     ImageVersionSource @default(edited)
  storageKey String             @map("storage_key")
  mimeType   String             @map("mime_type")
  width      Int
  height     Int
  byteSize   Int                @map("byte_size")
  operations Json?
  createdAt  DateTime           @default(now()) @map("created_at")

  @@unique([assetId, version])
  @@index([assetId, createdAt])
  @@map("image_versions")
}

model AudioAsset {
  id               String         @id @default(cuid())
  projectId        String         @map("project_id")
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  originalFilename String         @map("original_filename")
  mimeType         String         @map("mime_type")
  durationMs       Int            @map("duration_ms")
  sampleRate       Int            @map("sample_rate")
  channels         Int
  byteSize         Int            @map("byte_size")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  versions         AudioVersion[]

  @@index([projectId, updatedAt])
  @@map("audio_assets")
}

enum AudioVersionSource {
  original
  edited
}

model AudioVersion {
  id         String             @id @default(cuid())
  assetId    String             @map("asset_id")
  asset      AudioAsset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  version    Int
  source     AudioVersionSource @default(edited)
  storageKey String             @map("storage_key")
  mimeType   String             @map("mime_type")
  durationMs Int                @map("duration_ms")
  sampleRate Int                @map("sample_rate")
  channels   Int
  byteSize   Int                @map("byte_size")
  operations Json?
  createdAt  DateTime           @default(now()) @map("created_at")

  @@unique([assetId, version])
  @@index([assetId, createdAt])
  @@map("audio_versions")
}
