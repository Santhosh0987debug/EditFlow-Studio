# Copy this file to `.env` in the repository root.
# Never commit the real `.env` file.

# Express API
PORT=3001
NODE_ENV=development

# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/editflow_studio?schema=public"

# Secret used to sign session JWTs. Use at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Vite dev-server proxy target (optional, defaults to http://localhost:3001)
VITE_API_PROXY_TARGET=http://localhost:3001

# Image storage (optional). Uploaded originals and saved edits are written here.
# The default is uploads/images in the repository root, which is gitignored.
# IMAGE_STORAGE_DIR=uploads/images

# Audio storage (optional). Uploaded originals and saved edits are written here.
# The default is uploads/audio in the repository root, which is gitignored.
# AUDIO_STORAGE_DIR=uploads/audio

# FFmpeg binaries (optional). Both must support MP3 decoding/encoding.
# Defaults are "ffmpeg" and "ffprobe", resolved from PATH.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# AI text editing (optional). Without these the editor still works, and the
# AI panel explains that a provider must be configured.
# AI_PROVIDER=openai-compatible
# AI_API_KEY="replace-with-your-provider-api-key"
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
